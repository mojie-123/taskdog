    <!-- apple on table1: 桌面碰撞面 z=0.6613；自由落地实测 stable body z=0.6616
         （collision_flat + condim=6；9000 步静置：|w|≡0、倾角 0.00°、位移 0.78mm，
         其中 0.59mm 是 2.6e-5 m/s 的匀速残滑）。原值 0.6623 是
         "0.6613+未缩放网格 z_min(0.001)" 估出来的，会开局下落 ~0.7mm。 -->
    <body name="apple" pos="4.9 4.5 0.6616">
      <freejoint name="apple_freejoint" />
      <!-- visual mesh (no collision) -->
      <geom name="apple_visual" type="mesh" mesh="apple_visual"
            contype="0" conaffinity="0" group="1" material="apple_mat" />
      <!-- collision mesh（平顶化 collision_flat.obj：竖直夹持面 + 穹顶底面圆盘）
           condim="6"：让 friction 的第 3 项（滚动摩擦 0.01 = 10mm）真正生效
           （MuJoCo: condim=3 只有滑动、4 加扭转、6 加滚动；默认全局 condim=3
           时滚动项是死的 ⇒ 苹果滚走时没有任何滚动阻力） -->
      <geom name="apple_geom" type="mesh" mesh="apple_collision"
            mass="0.1" friction="5.0 0.01 0.01" condim="6"
            solref="0.004 1" solimp="0.99 0.999 0.001"
            rgba="0.9 0.1 0.1 1" />
    </body>
    <!-- cylinder on table1（原 bowl 已换为圆柱 r=2.5cm h=6cm，竖放）:
         body z = table_surface(0.6613) + 圆柱半高 0.03 = 0.6913。
         单 geom 身兼视觉+碰撞（group 默认 0 → 相机可见，AnyGrasp 靠它出抓取）。
         不再需要凸块拼装：圆柱是凸几何原语，不像 mesh（碰撞=凸包）会把空腔填实。
         圆盘面大、平底不滚 → condim 默认 3 即可（无需苹果那样的滚动摩擦）。
         橙色高饱和（vivid 过滤要 S≥80），区别于苹果红 0.9 0.1 0.1 与香蕉/方块黄 1 1 0。 -->
    <body name="bowl" pos="4.9 5.5 0.6913">
      <freejoint name="bowl_freejoint" />
      <geom name="bowl_geom" type="cylinder" size="0.025 0.03"
            mass="0.3" friction="5.0 0.01 0.01" solref="0.004 1" solimp="0.99 0.999 0.001"
            rgba="1 0.55 0 1" />
      <!-- 原 BOWL_COLLISION_BEGIN..END 凸块拼装块（50 个 box geom）已随 bowl→圆柱替换删除：
           圆柱是凸几何原语，不像 mesh（碰撞=凸包）会把空腔填实，无需拼装。
           仍可用 scripts/generate_bowl_collision.py 重新生成（若要还原旧碗）。 -->
    </body>
    <!-- test cube on table1: body z = table_surface(0.6613) + 半边长 0.02 = 0.6813
         4cm 立方体做 CLOSE 阶段专用测试物：两夹持面严格平行 → 两指同刻接触，
         是对"两段式冻结"最干净的几何（香蕉弓形会让两指接触步差很多）。
         单 geom 身兼视觉+碰撞（group 默认 0 → 相机可见，AnyGrasp 靠它出抓取）；
         视觉=碰撞，不存在"看不见的障碍"。mass 0.05kg 是刻意轻的：
         桌面摩擦容量 μmg≈0.6N，挤压力一旦不对称立刻把方块推走 → 最灵敏的探针。 -->
    <body name="cube" pos="4.95 6.0 0.6813">
      <freejoint name="cube_freejoint" />
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025"
            mass="0.01" friction="1.0 0.01 0.01" solref="0.004 1" solimp="0.99 0.999 0.001"
            rgba="1 1 0 1" />
    </body>
  </worldbody>

  <!-- Runtime base lock.  Inactive by default so NAV/REACH are unchanged.
       site-based weld aligns the live base frame to a mocap anchor placed at the
       current pose; solref/solimp make it a stiff physical constraint, not teleportation. -->
  <equality>
